{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@gradetracker/core/*": ["packages/core/src/*"],
      "@gradetracker/cli/*": ["packages/cli/src/*"],
      "@gradetracker/web/*": ["packages/web/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
