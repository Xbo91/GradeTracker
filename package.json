{
  "name": "gradetracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "turbo run build",
    "cli": "node packages/cli/dist/index.js",
    "dev:cli": "turbo run dev --filter=@gradetracker/cli",
    "dev:web": "turbo run dev --filter=@gradetracker/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0"
}
